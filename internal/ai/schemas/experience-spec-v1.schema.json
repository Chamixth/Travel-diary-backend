{
  "title": "VoyaLoom AI ExperienceSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatorVersion", "id", "dna", "scenes", "transitions", "globalEffects", "typography", "navigation", "responsiveRules"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0"] },
    "generatorVersion": { "type": "string", "enum": ["experience-planner-v1"] },
    "id": { "$ref": "#/$defs/text" },
    "dna": { "$ref": "#/$defs/dna" },
    "scenes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scene" } },
    "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
    "globalEffects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
    "typography": { "$ref": "#/$defs/typography" },
    "navigation": { "$ref": "#/$defs/navigation" },
    "responsiveRules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/responsiveRule" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "textArray": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
    "dna": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle", "creativeThesis", "interactionMetaphor", "emotionalArc", "visualLanguage", "motionLanguage", "navigationConcept", "signatureMoment", "constraints"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "subtitle": { "type": "string" },
        "creativeThesis": { "$ref": "#/$defs/text" },
        "interactionMetaphor": { "$ref": "#/$defs/text" },
        "emotionalArc": { "$ref": "#/$defs/emotionalArc" },
        "visualLanguage": { "$ref": "#/$defs/visualLanguage" },
        "motionLanguage": { "$ref": "#/$defs/motionLanguage" },
        "navigationConcept": { "$ref": "#/$defs/text" },
        "signatureMoment": { "$ref": "#/$defs/signatureMoment" },
        "constraints": { "$ref": "#/$defs/constraints" }
      }
    },
    "emotionalArc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opening", "development", "climax", "ending"],
      "properties": {
        "opening": { "$ref": "#/$defs/text" },
        "development": { "$ref": "#/$defs/text" },
        "climax": { "$ref": "#/$defs/text" },
        "ending": { "$ref": "#/$defs/text" }
      }
    },
    "visualLanguage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personality", "atmosphere", "paletteStrategy", "textureStrategy", "typographyStrategy", "imageTreatment"],
      "properties": {
        "personality": { "$ref": "#/$defs/textArray" },
        "atmosphere": { "$ref": "#/$defs/textArray" },
        "paletteStrategy": { "$ref": "#/$defs/text" },
        "textureStrategy": { "type": "string" },
        "typographyStrategy": { "$ref": "#/$defs/text" },
        "imageTreatment": { "$ref": "#/$defs/text" }
      }
    },
    "motionLanguage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personality", "intensity", "pacing", "physics", "scrollBehavior"],
      "properties": {
        "personality": { "$ref": "#/$defs/text" },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "pacing": { "$ref": "#/$defs/text" },
        "physics": { "$ref": "#/$defs/text" },
        "scrollBehavior": { "$ref": "#/$defs/text" }
      }
    },
    "signatureMoment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept", "sceneId", "assetIds", "memoryTest"],
      "properties": {
        "concept": { "$ref": "#/$defs/text" },
        "sceneId": { "$ref": "#/$defs/text" },
        "assetIds": { "$ref": "#/$defs/textArray" },
        "memoryTest": { "$ref": "#/$defs/text" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["avoid", "accessibilityNotes", "performanceNotes"],
      "properties": {
        "avoid": { "$ref": "#/$defs/textArray" },
        "accessibilityNotes": { "$ref": "#/$defs/textArray" },
        "performanceNotes": { "$ref": "#/$defs/textArray" }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "fallback"],
      "properties": {
        "id": { "type": "string", "enum": ["grain", "vignette", "none", "soft-haze", "light-leak", "letterbox", "monochrome", "color-wash"] },
        "version": { "$ref": "#/$defs/text" },
        "fallback": { "type": "string", "enum": ["none"] }
      }
    },
    "assetPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "role", "alt", "focalX", "focalY"],
      "properties": {
        "assetId": { "$ref": "#/$defs/text" },
        "role": { "$ref": "#/$defs/text" },
        "alt": { "$ref": "#/$defs/text" },
        "focalX": { "type": "number", "minimum": 0, "maximum": 1 },
        "focalY": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "sceneContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "body", "caption"],
      "properties": {
        "eyebrow": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "caption": { "type": "string" }
      }
    },
    "sceneFallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "motion"],
      "properties": {
        "layout": { "type": "string", "enum": ["cinematic-fullscreen", "editorial-split", "minimal-gallery", "film-strip", "contact-sheet", "scattered-prints", "timeline", "layered-depth", "horizontal-travel"] },
        "motion": { "type": "string", "enum": ["none"] }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chapterId", "layout", "motion", "assets", "content", "effects", "loadPriority", "fallback"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "chapterId": { "$ref": "#/$defs/text" },
        "layout": { "type": "string", "enum": ["cinematic-fullscreen", "editorial-split", "minimal-gallery", "film-strip", "contact-sheet", "scattered-prints", "timeline", "layered-depth", "horizontal-travel"] },
        "motion": { "type": "string", "enum": ["none", "gentle-reveal", "slow-zoom", "blur-to-focus", "depth-reveal", "horizontal-drift", "camera-flash", "exposure-reveal", "clip-reveal", "rise-and-settle"] },
        "assets": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/assetPlacement" } },
        "content": { "$ref": "#/$defs/sceneContent" },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "loadPriority": { "type": "string", "enum": ["eager", "nearby", "lazy"] },
        "fallback": { "$ref": "#/$defs/sceneFallback" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromSceneId", "toSceneId", "type", "durationMs"],
      "properties": {
        "fromSceneId": { "$ref": "#/$defs/text" },
        "toSceneId": { "$ref": "#/$defs/text" },
        "type": { "type": "string", "enum": ["cut", "crossfade", "dip-to-black", "wipe", "dissolve", "slide-over", "flash", "page-turn"] },
        "durationMs": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personality", "displayScale", "bodyMeasure"],
      "properties": {
        "personality": { "type": "string", "enum": ["cinematic", "editorial", "documentary", "quiet", "contemporary", "journal", "playful", "brutalist", "nostalgic", "technical", "handwritten-accent"] },
        "displayScale": { "$ref": "#/$defs/text" },
        "bodyMeasure": { "$ref": "#/$defs/text" }
      }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "showProgress", "keyboard", "label"],
      "properties": {
        "type": { "type": "string", "enum": ["chapter-marks", "scene-progress", "minimal-progress"] },
        "showProgress": { "type": "boolean" },
        "keyboard": { "type": "boolean", "enum": [true] },
        "label": { "$ref": "#/$defs/text" }
      }
    },
    "responsiveRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "breakpoint", "layout", "motion", "effectTier"],
      "properties": {
        "target": { "$ref": "#/$defs/text" },
        "breakpoint": { "type": "string", "enum": ["mobile", "tablet", "desktop"] },
        "layout": { "type": "string", "enum": ["cinematic-fullscreen", "editorial-split", "minimal-gallery", "film-strip", "contact-sheet", "scattered-prints", "timeline", "layered-depth", "horizontal-travel"] },
        "motion": { "type": "string", "enum": ["none", "gentle-reveal", "slow-zoom", "blur-to-focus", "depth-reveal", "horizontal-drift", "camera-flash", "exposure-reveal", "clip-reveal", "rise-and-settle"] },
        "effectTier": { "type": "string", "enum": ["A", "B", "C"] }
      }
    }
  }
}
