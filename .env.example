APP_NAME=travel-diary-backend
APP_ENV=development
PORT=8001

DATABASE_URL=mongodb://localhost:27017
MONGO_DATABASE=travel_diary

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.your-domain.com
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
# Optional override. Defaults to https://AUTH0_DOMAIN/.well-known/jwks.json
AUTH0_JWKS_URL=

CORS_ALLOWED_ORIGINS=http://localhost:8080

OPENAI_KEY=
OPENAI_MODEL_IMAGE_ANALYSIS=gpt-4o-mini
OPENAI_MODEL_CREATIVE=gpt-4o-mini
# Enables the separated structured Story Director. Failures are recorded and
# use the deterministic evidence-only fallback while the rollout is staged.
CREATIVE_PIPELINE_ENABLED=false
IMAGE_ANALYSIS_WORKERS=4
GENERATION_WORKERS=1
GENERATION_MAX_ATTEMPTS=3

# Legacy local-auth and Google OAuth settings. The current frontend uses Auth0.
JWT_SECRET=replace-in-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_STATE_SECRET=replace-in-production
GOOGLE_REDIRECT_URL=
FRONTEND_REDIRECT_URL=
